# APP_URL=http://localhost   (opcional; se vazio, a base URL é detectada automaticamente)
APP_TIMEZONE=America/Sao_Paulo

DB_HOST=localhost
DB_NAME=central_pedidos
DB_USER=root
DB_PASS=

# SMTP da hospedagem (ex: e-mail criado no cPanel)
MAIL_HOST=mail.seudominio.com.br
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=pedidos@seudominio.com.br
MAIL_PASSWORD=
MAIL_FROM_NAME="Central de Pedidos Escolares"

# Telefone de fallback da secretaria (usado se configuracoes estiver vazia)
WHATSAPP_FALLBACK=5500000000000